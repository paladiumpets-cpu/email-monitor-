# Google OAuth (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-VERCEL-URL.vercel.app/api/auth/callback

# Google Cloud project + Pub/Sub topic (from Google Cloud Console)
GOOGLE_PROJECT_ID=
PUBSUB_TOPIC=gmail-notifications
# Full topic name Gmail's watch() call needs, format: projects/PROJECT_ID/topics/TOPIC_NAME
PUBSUB_TOPIC_FULL=projects/YOUR_PROJECT_ID/topics/gmail-notifications

# Supabase (from Supabase project settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A random secret string you make up, used to protect the cron endpoint
CRON_SECRET=
